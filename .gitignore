!.env.study
!.env.production

# Test / coverage
coverage/
*.lcov

# Vite cache
.vite/

# Claude Code working files (project-local, not for the repo)
.claude/
CLAUDE_CODE_PROMPTS.md
.vercel
server/__pycache__/
# Local LLM outline cache (full build only; regenerated on demand, not frozen).
server/.outline_cache/
# Local LLM sentence-triage cache (regenerated on demand; the demo result is
# baked into src/data/defaultTriage.json, which IS committed).
server/.triage_cache/

# ASR transcribe service (Python venv + CI)
.github/
.venv/
# Local LLM conflict-check + timeline caches (regenerated on demand).
server/.anomaly_cache/
server/.timeline_cache/
# Runtime service logs
server/*.log
# Downloaded ASR eval datasets (audio) — fetched by scripts/, not tracked.
test_data/

# Study-data download tooling + its output — analysis-only, must NOT ship to
# GitHub (the output can contain participant data; the script needs a secret
# service_role key at runtime).
scripts/download_study_data.py
study_data/

# Python bytecode cache (from the local analysis script)
__pycache__/
*.pyc
